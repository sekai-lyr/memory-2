<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.youkeda.application.ebusiness.dao.UserDAO">

    <resultMap id="userResultMap" type="com.youkeda.application.ebusiness.dataobject.UserDO">
        <id column="id" property="id"/>
        <result column="gmt_created" property="gmtCreated"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="user_name" property="userName"/>
        <result column="password" property="password"/>
        <result column="mobile" property="mobile"/>
        <result column="email" property="email"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
    </resultMap>

    <insert id="batchAdd" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ykd_ebusiness_user (
        gmt_created, gmt_modified, user_name, password, mobile, email, name, gender
        ) VALUES
        <foreach collection="list" item="it" index="index" separator=",">
            (
            now(), now(), #{it.userName}, #{it.password}, #{it.mobile}, #{it.email}, #{it.name}, #{it.gender}
            )
        </foreach>
    </insert>

    <insert id="add" parameterType="com.youkeda.application.ebusiness.dataobject.UserDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ykd_ebusiness_user (
        gmt_created, gmt_modified, user_name, password, mobile, email, name,gender
        ) VALUES (
        now(), now(), #{userName}, #{password}, #{mobile}, #{email}, #{name},  #{gender}
        )
    </insert>

    <update id="update" parameterType="com.youkeda.application.ebusiness.dataobject.UserDO">
        UPDATE ykd_ebusiness_user
        SET
        gmt_modified = now(),
        user_name = #{userName},
        password = #{password},
        mobile = #{mobile},
        email = #{email},
        name = #{name},
        gender = #{gender}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM ykd_ebusiness_user WHERE id = #{id}
    </delete>

    <select id="findByUserName" resultMap="userResultMap">
        SELECT * FROM ykd_ebusiness_user WHERE user_name = #{userName}
    </select>

    <select id="findByIds" resultMap="userResultMap">
        select * from ykd_ebusiness_user
        <where>
            id in
            <foreach item="item" index="index" collection="ids"
                     open="(" separator="," close=")">
                #{item}
            </foreach>
        </where>
    </select>

</mapper>
