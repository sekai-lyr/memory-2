<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youkeda.application.ebusiness.dao.CategoryDAO">

    <resultMap id="CategoryResultMap" type="com.youkeda.application.ebusiness.dataobject.CategoryDO">
        <id column="id" property="id"/>
        <result column="gmt_created" property="gmtCreated"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="parent_category_id" property="parentCategoryId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,gmt_created,gmt_modified,name,description,parent_category_id
    </sql>

    <select id="selectAll" resultMap="CategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ykd_ebusiness_category
        ORDER BY parent_category_id ASC, id ASC
    </select>

    <select id="selectById" resultMap="CategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ykd_ebusiness_category
        WHERE id = #{id}
    </select>

    <select id="selectByParentId" resultMap="CategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ykd_ebusiness_category
        WHERE parent_category_id = #{parentCategoryId}
        ORDER BY id ASC
    </select>

    <insert id="insert" parameterType="com.youkeda.application.ebusiness.dataobject.CategoryDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ykd_ebusiness_category (
            gmt_created, gmt_modified, name, description, parent_category_id
        ) VALUES (
            now(), now(), #{name}, #{description}, #{parentCategoryId}
        )
    </insert>

</mapper>
